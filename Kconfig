config ZMK_JOYCON2
    bool "Joy-Con 2 controller support"
    default y

if ZMK_JOYCON2

config ZMK_JOYCON2_LEGACY_ENDPOINT_API
    bool "Target a ZMK tree with the pre-rename endpoint API"
    # The shmatt/zmk feat/mouse-keys-3.2 fork has zmk_endpoints_send_report()
    # and friends; upstream ZMK renamed them to the singular
    # zmk_endpoint_send_report(). Enable this when building against the fork.
    default n

config ZMK_JOYCON2_DEBUG_PRINT
    bool "HID debug-print helper (types debug text as keystrokes via the host HID connection)"
    default y

config ZMK_JOYCON2_CENTRAL_TEST
    bool "Stage 1 sub-stage 2: third BLE central role survival test"
    depends on ZMK_JOYCON2_DEBUG_PRINT
    default y

config ZMK_JOYCON2_CONNECT
    bool "Stage 1 sub-stage 4: connect to a real Joy-Con 2 and relay raw input bytes"
    depends on ZMK_JOYCON2_DEBUG_PRINT
    default y

config ZMK_JOYCON2_BOND
    bool "Store this host on the controller so it reconnects without SYNC"
    depends on ZMK_JOYCON2_CONNECT
    # Sends the controller's proprietary pairing sequence (host address plus
    # two host-chosen keys) after input is already streaming. Affects only
    # future reconnections, never the current session: once bonded the
    # controller advertises this host's address and wakes for it on a button
    # press, instead of needing SYNC held every time.
    default y

config ZMK_JOYCON2_AUTO_RECONNECT
    bool "Scan for a bonded controller again after it disconnects"
    depends on ZMK_JOYCON2_BOND
    # OFF by default, and that is a considered default rather than caution:
    #
    #  * Zephyr allows ONE scanner with ONE callback, and ZMK's split central
    #    scans persistently whenever a peripheral slot is unconnected. While
    #    this module holds the scanner, ZMK's start_scanning() gets -EALREADY
    #    but leaves its own is_scanning flag set, so once our scan ends nobody
    #    is scanning and ZMK believes it still is -- the other keyboard half
    #    can then stay disconnected until a reset. Short, occasional windows
    #    make that unlikely; a persistent scan would make it likely.
    #  * A controller only advertises while awake. If it wakes on being jostled
    #    (in a bag, say) an always-powered keyboard would reconnect to it and
    #    quietly drain its battery.
    #
    # Enable it if reconnecting without holding SYNC matters more than either
    # of those, and prefer to leave the window bounded.
    default n

config ZMK_JOYCON2_AUTO_RECONNECT_WINDOW_SEC
    int "How long to keep scanning after a disconnect"
    depends on ZMK_JOYCON2_AUTO_RECONNECT
    # Bounded rather than forever, to keep the scanner-contention window small.
    default 60

config ZMK_JOYCON2_GAMEPAD
    bool "Expose decoded Joy-Con 2 input to the host as a gamepad"
    depends on ZMK_JOYCON2_CONNECT
    # The gamepad report itself comes from ZMK (report ID 4 in its own HID
    # interface), which needs a ZMK tree carrying the feat/gamepad-hid
    # patch. An earlier approach used zmk-hid-io's separate HID service,
    # but a second HIDS service stops Android pairing with the keyboard at
    # all.
    depends on ZMK_GAMEPAD
    default y

endif # ZMK_JOYCON2
